# Copy to .env and fill in. Never commit .env.
# The values below are EXAMPLES (kept real-looking so CI can validate compose.yaml);
# replace them with your own.

# --- Service ---

# Listen address (host:port) inside the container (default :8080).
# compose.yaml fixes this to 127.0.0.1:8080 so only `tailscale serve` in the same
# network namespace can reach it; set it only when running outside compose.
NAS_FILE_API_ADDR=:8080

# --- compose.yaml only (Container Manager Project) ---

# Required: UID and GID of the dedicated DSM user the API container runs as (never 0/root).
# Find them over SSH with: id <dsm-user>
NAS_FILE_API_UID=1026
NAS_FILE_API_GID=100

# Required: the NAS folder that is the Upload Root (mounted at /data in the API container).
NAS_FILE_API_UPLOAD_ROOT_NAS_PATH=/volume1/uploads

# Required: NAS folder for the Tailscale sidecar's state. Must be outside the Upload Root.
NAS_FILE_API_TS_STATE_NAS_PATH=/volume1/docker/dreambig-nas-file-api/tailscale-state

# Tailscale auth key for the sidecar, tagged tag:nas-file-api. Needed only until the
# sidecar has logged in once (its state is then kept in NAS_FILE_API_TS_STATE_NAS_PATH).
NAS_FILE_API_TS_AUTHKEY=<tskey-auth-from-tailscale-admin-console>

# Optional: the sidecar's tailnet machine name (default nas-file-api); the API is then
# served at https://<name>.<tailnet>.ts.net.
NAS_FILE_API_TS_HOSTNAME=nas-file-api
